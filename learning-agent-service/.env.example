APP_NAME=learning-agent-service
APP_ENV=local
APP_PORT=9000
WORKFLOW_VERSION=learn-agent/v1

POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/learning_agent
POSTGRES_POOL_SIZE=10

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=learn

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
KNOWLEDGE_COLLECTION=knowledge_chunks
MEMORY_COLLECTION=user_semantic_memory

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT=60

LOG_LEVEL=INFO
ENABLE_TRACE=false
REQUEST_TIMEOUT_MS=30000
